{
  "name": "jwww",
  "productName": "JWWW",
  "version": "0.1.0",
  "description": "JWWW — um navegador para devs: overrides resilientes, expose-to-global, bus entre abas e userscripts",
  "author": "Jonathan Reis dos Santos <brjs.santos@gmail.com>",
  "license": "MIT",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "preview": "electron-vite preview",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "tsx tests/prettify.test.ts && tsx tests/glob.test.ts && tsx tests/analyze.test.ts && tsx tests/sourcemap.test.ts && tsx tests/mapping.test.ts",
    "test:e2e": "npm run build && playwright test",
    "icon": "electron scripts/make-icon.cjs",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac --universal",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "acorn": "^8.14.1",
    "diff-match-patch": "^1.0.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/diff-match-patch": "^1.0.36",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^37.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "js-beautify": "^2.0.3",
    "lucide-react": "^0.525.0",
    "monaco-editor": "^0.52.2",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^3.0.3",
    "sonner": "^2.0.5",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "tldts": "^6.1.86",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "zustand": "^5.0.5"
  }
}
